# the app id is on the github app settings page
GITHUB_APP_ID=123456

# base64 of the private key file: base64 -w0 my-app.private-key.pem
GITHUB_PRIVATE_KEY=

# the same secret that is set on the webhook of the github app
GITHUB_WEBHOOK_SECRET=change-me

# local, jira or servicenow
BACKEND_MODE=local

LOCAL_TICKETS_PATH=./tickets

# a free jira cloud site works, the approval is the status of the issue and the
# window end is the due date
# JIRA_BASE_URL=https://mycompany.atlassian.net
# JIRA_EMAIL=me@mycompany.com
# JIRA_API_TOKEN=
# JIRA_APPROVED_STATUSES=approved,ready for deployment
# JIRA_REJECTED_STATUSES=rejected,cancelled
# JIRA_WINDOW_START_FIELD=
# JIRA_WINDOW_END_FIELD=duedate

# a free personal developer instance works, dev12345.service-now.com
# SERVICENOW_BASE_URL=https://dev12345.service-now.com
# SERVICENOW_USERNAME=admin
# SERVICENOW_PASSWORD=
# SERVICENOW_APPROVED_STATES=scheduled,implement
# SERVICENOW_REJECTED_STATES=canceled,cancelled,closed
